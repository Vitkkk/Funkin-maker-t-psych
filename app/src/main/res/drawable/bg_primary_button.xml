<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#273042" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#2BC7E8" android:endColor="#DE3B8D" android:angle="0" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#4DE8FF" android:endColor="#FF4D9D" android:angle="0" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
