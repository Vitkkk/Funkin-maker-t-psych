<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#202A3B" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#4DE8FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B2231" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#303B50" />
        </shape>
    </item>
</selector>
